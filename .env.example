# App
PANTHEON_APP_NAME="Pantheon Graph"
PANTHEON_HOST=127.0.0.1
PANTHEON_PORT=8080

# Adapters (enable what you need)
PANTHEON_ENABLE_MEMORY_ADAPTER=true
PANTHEON_ENABLE_WIKIDATA_ADAPTER=false
PANTHEON_ENABLE_ARANGO_ADAPTER=false
PANTHEON_ENABLE_NEO4J_ADAPTER=false

# Wikidata
# Optional override of endpoint; set a proper UA when enabling Wikidata
# PANTHEON_WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql
PANTHEON_WIKIDATA_USER_AGENT=PantheonGraph/0.1 (+https://your.site)

# ArangoDB (enable ARANGO ADAPTER and fill creds)
# PANTHEON_ARANGO_URL=http://localhost:8529
# PANTHEON_ARANGO_DB=_system
# PANTHEON_ARANGO_USER=root
# PANTHEON_ARANGO_PASSWORD=pass
# Either use named graph OR explicit collections
# PANTHEON_ARANGO_GRAPH=
# PANTHEON_ARANGO_VERTEX_COLLECTION=
# PANTHEON_ARANGO_EDGE_COLLECTION=

# Neo4j (enable NEO4J adapter and fill creds)
# PANTHEON_NEO4J_URI=bolt://localhost:7687
# PANTHEON_NEO4J_USER=neo4j
# PANTHEON_NEO4J_PASSWORD=pass

# Redis (optional: cache + taskiq broker)
# PANTHEON_REDIS_DSN=redis://localhost:6379/0

# Integration (optional)
# Public API base for the web UI proxying to adapter (if UI served elsewhere)
# PANTHEON_PUBLIC_API_BASE=https://api.example.com
# CORS origins: JSON list or CSV are accepted
# Example JSON: ["https://example.github.io","https://demo.example.com"]
# Example CSV: https://example.github.io, https://demo.example.com
# PANTHEON_CORS_ORIGINS=

