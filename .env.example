# Copy to .env and adjust. Every setting is prefixed with PANTHEON_;
# nested sections use a double underscore (PANTHEON_NEO4J__URI).

# --- Server -------------------------------------------------------------------
PANTHEON_HOST=127.0.0.1
PANTHEON_PORT=8080
PANTHEON_LOG_LEVEL=INFO
# Base URL of the API when the UI is served from another origin
# PANTHEON_PUBLIC_API_BASE=https://api.example.com
# Browser origins allowed to call the API: JSON list or comma separated
# PANTHEON_CORS_ORIGINS=https://example.github.io,https://demo.example.com

# --- Sources ------------------------------------------------------------------
# Bundled Greek pantheon, no external services needed
PANTHEON_MEMORY__ENABLED=true

# Wikidata SPARQL; please identify your deployment in the user agent
PANTHEON_WIKIDATA__ENABLED=false
# PANTHEON_WIKIDATA__USER_AGENT=PantheonGraph/1.0 (https://your.site; you@example.com)
# PANTHEON_WIKIDATA__LANGUAGE=en

# Neo4j (fill it with: pantheon-graph seed neo4j)
PANTHEON_NEO4J__ENABLED=false
# PANTHEON_NEO4J__URI=neo4j://localhost:7687
# PANTHEON_NEO4J__USER=neo4j
# PANTHEON_NEO4J__PASSWORD=pantheon-secret

# ArangoDB: a named graph, or an explicit vertex + edge collection pair
# (fill it with: pantheon-graph seed arango)
PANTHEON_ARANGO__ENABLED=false
# PANTHEON_ARANGO__URL=http://localhost:8529
# PANTHEON_ARANGO__DATABASE=_system
# PANTHEON_ARANGO__USER=root
# PANTHEON_ARANGO__PASSWORD=pantheon-secret
# PANTHEON_ARANGO__GRAPH=pantheon
# PANTHEON_ARANGO__VERTEX_COLLECTION=
# PANTHEON_ARANGO__EDGE_COLLECTION=

# Per-source time budget, seconds
# PANTHEON_SOURCE_TIMEOUT=30

# --- Cache & background refresh -----------------------------------------------
# Without Redis the cache lives in process memory
# PANTHEON_REDIS_URL=redis://localhost:6379/0
# Seconds; 0 keeps the snapshot until the next refresh
PANTHEON_CACHE_TTL=3600
# Periodic refresh run by the taskiq scheduler
PANTHEON_REFRESH_CRON=*/30 * * * *
